<?xml version="1.0" encoding="UTF-8"?>
<!--
  The schema of GET /api/v1/issues/{id}/export.xml, version 2.

  What changed from version 1, and why it is a new file rather than an edit to
  the old one: an export is now written in the language of whoever asked for it,
  so <field name="…"> could no longer be the English label — a consumer matching
  on name="Due date" would simply stop matching the first time the same export
  was taken in German. `name` is therefore a stable key that never varies with
  the language ("dueDate"), and the label the document actually prints moved to
  the new, optional `label` attribute. No element was renamed or removed, but the
  VALUE of an existing attribute changed meaning, which breaks a consumer exactly
  as a rename would — hence version 2 and issue-export-v1.xsd left untouched
  beside this, for documents produced before 10.2.1.

  Timestamps changed with it: `generatedAt`, and the `at` / `uploadedAt`
  attributes, are ISO-8601 with the reader's offset (2026-08-27T01:50:00+02:00)
  rather than "2026-08-26 23:50 UTC". A machine format for the machine-readable
  export; the formats a person reads carry the localized spelling instead.

  It is published because the format is a contract the moment anybody scripts
  against it. The rule for changing it: adding an element or an attribute keeps
  version="1" and is edited into this file, because a consumer that reads the
  elements it knows by name is unaffected — one that validates against a copy of
  this file taken earlier is not, and has to take the new copy. Renaming or
  removing an element breaks both kinds of consumer, so that is version="2" and
  a new file beside this one. Every section is optional in the sense that it can
  be empty — the export's query parameters can switch comments, links,
  attachments and history off — but the elements themselves are always present,
  so a consumer never has to distinguish "absent" from "empty".
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <!-- The description of an issue or of a comment: a flat sequence of blocks. -->
  <xs:group name="blocks">
    <xs:choice>
      <xs:element name="heading">
        <xs:complexType>
          <xs:simpleContent>
            <xs:extension base="xs:string">
              <xs:attribute name="level" type="xs:positiveInteger" use="required"/>
            </xs:extension>
          </xs:simpleContent>
        </xs:complexType>
      </xs:element>
      <xs:element name="p" type="xs:string"/>
      <xs:element name="list">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="item" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
          <xs:attribute name="ordered" type="xs:boolean" use="required"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="code">
        <xs:complexType>
          <xs:simpleContent>
            <xs:extension base="xs:string">
              <xs:attribute name="language" type="xs:string" use="required"/>
            </xs:extension>
          </xs:simpleContent>
        </xs:complexType>
      </xs:element>
      <xs:element name="quote" type="xs:string"/>
      <xs:element name="table">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="row" minOccurs="0" maxOccurs="unbounded">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="cell" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
                </xs:sequence>
                <xs:attribute name="header" type="xs:boolean"/>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="rule">
        <xs:complexType/>
      </xs:element>
    </xs:choice>
  </xs:group>

  <xs:element name="issue">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="title" type="xs:string"/>
        <xs:element name="project" type="xs:string"/>
        <xs:element name="organization" type="xs:string"/>
        <xs:element name="generatedAt" type="xs:string"/>

        <xs:element name="fields">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="field" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:simpleContent>
                    <xs:extension base="xs:string">
                      <!-- Stable, language-independent: "dueDate". Match on this. -->
                      <xs:attribute name="name" type="xs:string" use="required"/>
                      <!-- The same field as the document spells it for its reader.
                           Optional so a future field with no translation is still
                           a valid document. -->
                      <xs:attribute name="label" type="xs:string"/>
                    </xs:extension>
                  </xs:simpleContent>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="description">
          <xs:complexType>
            <xs:group ref="blocks" minOccurs="0" maxOccurs="unbounded"/>
          </xs:complexType>
        </xs:element>

        <xs:element name="comments">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="comment" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:group ref="blocks" minOccurs="0" maxOccurs="unbounded"/>
                  <xs:attribute name="author" type="xs:string" use="required"/>
                  <xs:attribute name="at" type="xs:string" use="required"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="count" type="xs:nonNegativeInteger" use="required"/>
          </xs:complexType>
        </xs:element>

        <xs:element name="links">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="link" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:simpleContent>
                    <xs:extension base="xs:string">
                      <xs:attribute name="verb" type="xs:string" use="required"/>
                      <xs:attribute name="key" type="xs:string" use="required"/>
                    </xs:extension>
                  </xs:simpleContent>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="count" type="xs:nonNegativeInteger" use="required"/>
          </xs:complexType>
        </xs:element>

        <xs:element name="attachments">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="attachment" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="name" type="xs:string" use="required"/>
                  <xs:attribute name="contentType" type="xs:string" use="required"/>
                  <xs:attribute name="size" type="xs:string" use="required"/>
                  <xs:attribute name="uploader" type="xs:string" use="required"/>
                  <xs:attribute name="uploadedAt" type="xs:string" use="required"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="count" type="xs:nonNegativeInteger" use="required"/>
          </xs:complexType>
        </xs:element>

        <xs:element name="activity">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="entry" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:simpleContent>
                    <xs:extension base="xs:string">
                      <xs:attribute name="at" type="xs:string" use="required"/>
                      <xs:attribute name="actor" type="xs:string" use="required"/>
                    </xs:extension>
                  </xs:simpleContent>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="count" type="xs:nonNegativeInteger" use="required"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>

      <xs:attribute name="version" type="xs:string" use="required"/>
      <xs:attribute name="key" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
